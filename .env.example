# Obligatoire : mot de passe Redis (long et aléatoire, ex. `openssl rand -hex 32`)
REDIS_PASSWORD=
# Optionnel : si rempli, il faut ce code pour créer un compte (modifiable ensuite depuis l'admin)
INVITE_CODE=
# Administrateurs, séparés par des virgules. Ces comptes retrouvent leurs droits à chaque
# démarrage et ne peuvent être ni rétrogradés ni suspendus depuis l'interface.
ADMIN_USERS=EIRBLAST
# 1 en production (HTTPS via Coolify), 0 seulement pour tester en local en http
COOKIE_SECURE=1
# Vues minimum pour qu'une vidéo entre dans le jeu
MIN_VIEWS=10000

# ---- Worker : rythme ----
# Pause entre deux cycles, et âge à partir duquel les vues d'une carte sont rafraîchies
CYCLE_PAUSE=60
REFRESH_DAYS=7
DISCOVER=1
# Durée minimale d'une vidéo, en secondes (écarte les Shorts)
MIN_SECONDS=60

# ---- Worker : volume moissonné par cycle ----
# Requêtes en parallèle vers les instances publiques (rester modeste : elles sont bénévoles)
API_WORKERS=4
# Budget de requêtes « une vidéo » par cycle, et cartes complétées (catégorie, j'aime) par cycle
DETAILS_PER_CYCLE=120
ENRICH_PER_CYCLE=60
# Mots-clés tirés par cycle, pages par mot-clé, chaînes relues par RSS, recommandations dépilées
KEYWORDS_PER_CYCLE=6
SEARCH_PAGES=3
CHANNELS_PER_CYCLE=30
RELATED_PER_CYCLE=60

# ---- Worker : sources de données ----
# Instances Invidious / Piped, séparées par des virgules. Vides = listes par défaut du worker,
# complétées automatiquement par l'annuaire officiel Invidious au démarrage.
# Ces instances ferment souvent : si les logs annoncent « aucune instance exploitable »,
# renseigne-les depuis https://api.invidious.io/ et https://piped.video/
INVIDIOUS_INSTANCES=
PIPED_INSTANCES=

# ---- Worker : yt-dlp (secours et sources ytsearch:) ----
USE_YTDLP=1
PER_SOURCE=30
PAUSE=2
# Optionnel : proxy si YouTube bloque l'IP du VPS (http://user:pass@hote:port)
YTDLP_PROXY=
